{
  "name": "f7-developer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run discover:validate",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify:export": "node scripts/verify-export.mjs",
    "format": "prettier --write .",
    "discover:validate": "node scripts/discover.mjs validate",
    "discover:publish": "node scripts/discover.mjs publish"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
